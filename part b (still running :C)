from sklearn.model_selection import LeaveOneOut
import numpy as np
import pandas as pd
from scipy.spatial.distance import cdist
from collections import Counter

# Optimized k-NN Class with Minkowski Distance
class KNN:
    def __init__(self, k, p=2):
        self.k = k
        self.p = p
        self.features = None
        self.labels = None

    def fit(self, features, labels):
        self.features = features.to_numpy()
        self.labels = labels.to_numpy()

    def predict(self, X):
        X = X.to_numpy()
        distances = cdist(X, self.features, metric='minkowski', p=self.p)  # Efficient distance computation
        nearest_indices = np.argsort(distances, axis=1)[:, :self.k]
        nearest_labels = self.labels[nearest_indices]
        predictions = np.array([Counter(row).most_common(1)[0][0] for row in nearest_labels])  # Most common label
        return predictions

